# Exemplo para implantação. Carregue por seu gerenciador de processos
# ou com node --env-file=.env server.js; npm start não lê .env automaticamente.
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://seu-dominio.com.br
# Configure somente atrás de proxy reverso confiável, com acesso direto bloqueado.
TRUST_PROXY=1
# Volume persistente. Não cubra os arquivos legados sem antes migrá-los.
# DATA_DIR=/volume/whatsapp-data
